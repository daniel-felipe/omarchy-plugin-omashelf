#!/usr/bin/env python3
"""Bounded reader/writer for the Omashelf library file.

The only thing that opens the library. Every access opens the path once with
O_NOFOLLOW and O_NONBLOCK, verifies on that descriptor that it is a regular file
within the byte cap, and reads at most cap bytes from that same descriptor, so
the bytes handed to the widget are always the bytes that were measured. Checking
the path and opening it separately would leave a window to swap it.

Usage: omashelf-io <library-path> <max-bytes>

Events written to stdout, one JSON object per line:
  {"event": "state", "status": "ok",          "bytes": N, "text": "..."}
  {"event": "state", "status": "missing",     "bytes": 0}
  {"event": "state", "status": "too-large",   "bytes": N}
  {"event": "state", "status": "not-regular", "bytes": 0}
  {"event": "state", "status": "error",       "bytes": 0, "message": "..."}
  {"event": "write", "ok": true|false, "message": "..."}

Commands read from stdin, one JSON object per line:
  {"cmd": "write", "text": "..."}
  {"cmd": "poll"}
"""

import errno
import json
import os
import select
import stat
import sys

POLL_SECONDS = 1.0


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def read_bounded(path, cap):
    """Open once, verify the descriptor, then read from that descriptor only.

    `identity` comes from the fstat that authorized the read, so the poll loop
    sees a replaced file as a change.
    """
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            return "missing", "", None
        if exc.errno in (errno.ELOOP, errno.EMLINK):
            return "not-regular", "", None
        return "error", "", None

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return "not-regular", "", None
        identity = (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
        if st.st_size > cap:
            return "too-large", "", identity
        # One byte past the cap, so a file that grew after the fstat is
        # rejected rather than truncated.
        os.set_blocking(fd, True)
        chunks = []
        remaining = cap + 1
        while remaining > 0:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        if len(data) > cap:
            return "too-large", "", identity
        return "ok", data.decode("utf-8", "replace"), identity
    except OSError:
        return "error", "", None
    finally:
        os.close(fd)


def state_event(status, text, size):
    event = {"event": "state", "status": status, "bytes": size}
    if status == "ok":
        event["text"] = text
    return event


def write_library(path, cap, text):
    """Replace the library atomically, refusing to write past the cap."""
    payload = text.encode("utf-8")
    if len(payload) > cap:
        return False, "refusing to write %d bytes, over the %d byte cap" % (len(payload), cap)
    # A symlink, fifo or device at that path is the user's, not ours to clobber.
    try:
        existing = os.lstat(path)
    except OSError as exc:
        if exc.errno != errno.ENOENT:
            return False, str(exc)
    else:
        if not stat.S_ISREG(existing.st_mode):
            return False, "refusing to replace a path that is not a regular file"
    directory = os.path.dirname(path) or "."
    try:
        os.makedirs(directory, exist_ok=True)
    except OSError as exc:
        return False, str(exc)
    tmp = os.path.join(directory, ".omashelf-%d.tmp" % os.getpid())
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(tmp, flags, 0o600)
    except OSError as exc:
        return False, str(exc)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        return True, ""
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False, str(exc)


def main():
    if len(sys.argv) != 3:
        sys.stderr.write("usage: omashelf-io <library-path> <max-bytes>\n")
        return 2
    path = sys.argv[1]
    try:
        cap = int(sys.argv[2])
    except ValueError:
        sys.stderr.write("omashelf-io: max-bytes must be a number\n")
        return 2
    if cap <= 0:
        sys.stderr.write("omashelf-io: max-bytes must be positive\n")
        return 2

    last = object()  # Never equal to a real identity, so the first poll emits.

    def check(force=False):
        nonlocal last
        status, text, identity = read_bounded(path, cap)
        key = (status, identity)
        if not force and key == last:
            return
        last = key
        size = identity[2] if identity else 0
        emit(state_event(status, text, size))

    check()

    stdin = sys.stdin
    while True:
        ready, _, _ = select.select([stdin], [], [], POLL_SECONDS)
        if not ready:
            check()
            continue
        line = stdin.readline()
        if line == "":
            return 0
        line = line.strip()
        if line == "":
            continue
        try:
            command = json.loads(line)
        except ValueError:
            emit({"event": "write", "ok": False, "message": "unparseable command"})
            continue
        name = command.get("cmd")
        if name == "write":
            ok, message = write_library(path, cap, str(command.get("text", "")))
            emit({"event": "write", "ok": ok, "message": message})
            check(force=True)
        elif name == "poll":
            check(force=True)


if __name__ == "__main__":
    sys.exit(main())
